{
  "name": "jev-mcp",
  "version": "0.4.0",
  "private": true,
  "description": "General-purpose MCP server for TypeSafe Jev",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "jev-mcp": "dist/transport/stdio.js"
  },
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "test:e2e": "npm run build && vitest run --config vitest.e2e.config.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/transport/stdio.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drmedia/jev-mcp.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "vite": "^7.3.7"
  }
}
