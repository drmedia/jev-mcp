# Optional. typesafe (default), openrouter, or local.
JEV_PROVIDER=

# Required when JEV_PROVIDER=typesafe. TypeSafe API key. Never commit a real value.
TYPESAFE_API_KEY=

# Optional. Defaults to https://api.typesafe.ai
TYPESAFE_BASE_URL=

# Required when JEV_PROVIDER=openrouter. OpenRouter API key. Never commit a real value.
OPENROUTER_API_KEY=

# Optional. API root without /v1. Defaults to https://openrouter.ai/api
OPENROUTER_BASE_URL=

# Optional, for JEV_PROVIDER=local. Root of a local System One server (for example
# llama.cpp llama-server, see docs/local-provider.md). Defaults to http://127.0.0.1:8097
JEV_LOCAL_BASE_URL=

# Optional, for JEV_PROVIDER=local. Only if the local server requires a key.
JEV_LOCAL_API_KEY=

# Optional. Defaults to jev-latest. With OpenRouter, for example cloudflare/clef-flash.
JEV_MODEL=

# Optional. Absolute directories that images[].path may read from, separated by ";"
# on Windows and ":" elsewhere. Unset disables image paths.
JEV_IMAGE_DIRS=

# Optional. Maximum characters of state plus questions per request. Defaults to
# 256000 (about 64k tokens of English text); 0 disables the check.
JEV_MAX_INPUT_CHARS=

# Optional. Provider requests jev.evaluate_batch runs at the same time (1-16).
# Defaults to 4.
JEV_MAX_CONCURRENCY=

# Optional. Milliseconds to wait for each provider request attempt (1000-600000).
# Defaults to 30000.
JEV_TIMEOUT_MS=

# Optional. error, warn (default), info or debug. Logs go to stderr.
JEV_LOG_LEVEL=

# Optional. Retries for transient failures (0-10). Defaults to 2; 0 disables retries.
JEV_MAX_RETRIES=

# Required for npm run start:http only. Shared secret clients send as
# "Authorization: Bearer <token>"; at least 32 characters. Never commit a real value.
JEV_HTTP_TOKEN=

# Optional, for npm run start:http. Defaults to 8098. The server listens on 127.0.0.1 only.
PORT=
